import java.util.Scanner;
class Mul
{
   public static void main(String[] args)
   {
      Scanner input = new Scanner(System.in);
      System.out.println("enter a table number:");
      int a = input.nextInt();
      for(int i =1;i<=10;i++)
      {
         int b = i*a;
         System.out.println(+i + "*" +a + "=" +b);
      }
   }
}
