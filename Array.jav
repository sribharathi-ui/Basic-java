class main{
   public static void main(String[] args)
   {
      int num;
      /**
       * @param integer
       */
      num = 100;
      System.out.println("This is num:" +num);
      num = num*2;
      System.out.print("The value of num*2 is:");
      System.out.println(num);
   }
}
